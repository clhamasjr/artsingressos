# ============================================================
# Arts Ingressos - variáveis de ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local — está no .gitignore.
# ============================================================

# --- FRONT (Vite) - prefixo VITE_ é exposto ao navegador ---
# Só coloque chaves PÚBLICAS aqui. NUNCA service_role nem MP access token.
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...
VITE_SITE_URL=http://localhost:5173

# --- Pixels (públicos no front) ---
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# ============================================================
# SECRETS - configurar em Edge Functions e Vercel, NUNCA no front
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# VOUCHER_HMAC_SECRET=
# RESEND_API_KEY=
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# META_CONVERSIONS_API_TOKEN=
# TIKTOK_EVENTS_API_TOKEN=
